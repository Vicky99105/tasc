OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-3.7-flash
MODEL_SUMMARY=google/gemini-3-flash-preview
REFERENCE_DATE=2026-08-19

SLACK_WEBHOOK_URL=

LANGFUSE_HOST=http://localhost:3000
# These two match the keys observability/docker-compose.yml auto-provisions on
# first boot (LANGFUSE_INIT_PROJECT_PUBLIC_KEY / _SECRET_KEY) — local dev only,
# never used outside your own machine. Leave as-is for local Docker; if you
# point at Langfuse Cloud or a shared instance instead, replace with real keys.
LANGFUSE_PUBLIC_KEY=pk-lf-local-dev-0000000000000000
LANGFUSE_SECRET_KEY=sk-lf-local-dev-0000000000000000
